tables:
  - name: animals
    source:
      parquet: data.parquet
    columns:
      - name: name
        type: string
        examples: [otter, seal]
      - name: addr
        type: struct
        fields:
          - name: street
            type: string
            examples: [123 Main St]
          - name: zip
            type: string
            examples: ['97201']
          - name: country
            type: enum
            values: [US, CA, XX]
      - name: tags
        type: list(enum)
        values: [a, b, zz]
