$version: "0.1.0"
$learn_more: http://data-dict.tidyverse.org/
tables:
  - name: animals
    source:
      parquet: data.parquet
    columns:
      - name: name
        type: string
        examples: [otter, seal]
      - name: addr
        type: struct
        fields:
          - name: zip
            type: number(id)
            examples: [97201]
          - name: country
            type: enum
            values: [US, CA, XX]
      - name: tags
        type: list(enum)
        values: [a, b, zz]
